# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Inkbunny credentials (optional, guest mode if unset)
INKBUNNY_USERNAME=
INKBUNNY_PASSWORD=

# Path to Instagram cookies JSON file (required for Instagram support)
# Export cookies from instagram.com via a browser extension (e.g. Cookie Editor)
# as a JSON array: [{"name":"sessionid","value":"...","domain":".instagram.com","path":"/","secure":true}, ...]
INSTAGRAM_COOKIES_FILE=
